{
  "name": "velour",
  "version": "1.0.0-beta.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "format": "prettier --write --experimental-cli src/",
    "format:check": "prettier --check --experimental-cli src/",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "fix": "run-s fix:*",
    "fix:oxlint": "oxlint --fix .",
    "fix:eslint": "eslint --fix . --cache",
    "gen:plugin": "tsx --tsconfig tsconfig.app.json scripts/generate-plugin.ts"
  },
  "dependencies": {
    "@shikijs/langs": "^4.2.0",
    "@shikijs/themes": "^4.2.0",
    "shiki": "^4.2.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.20",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.1",
    "commander": "^15.0.0",
    "daisyui": "^5.5.23",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^63.0.7",
    "eslint-plugin-oxlint": "~1.67.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.67.0",
    "prettier": "3.8.3",
    "prettier-plugin-jsdoc": "^1.8.1",
    "shellcheck": "^4.1.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vite-plugin-vue-devtools": "^8.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
